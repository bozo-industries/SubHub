<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/nav_active_pressed"
                android:endColor="@color/accent_dark" />
            <stroke android:width="1dp" android:color="@color/accent_hot" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/nav_active"
                android:endColor="#FF51234E" />
            <stroke android:width="1dp" android:color="@color/accent_glow" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
