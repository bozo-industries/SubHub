<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF352047"
                android:endColor="#FF4A1D45" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#F21A1224"
                android:endColor="#F225142C" />
            <stroke android:width="1dp" android:color="#806C3A79" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
