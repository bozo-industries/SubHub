<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E52A1B31" />
            <stroke android:width="1dp" android:color="#A5784C82" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D71A1320"
                android:endColor="#D723172B" />
            <stroke android:width="1dp" android:color="#78624770" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
