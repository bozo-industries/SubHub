<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D33A1D42" />
            <stroke android:width="1dp" android:color="@color/accent_hot" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#B1261730"
                android:endColor="#B4381732" />
            <stroke android:width="1dp" android:color="#9A8B3C8C" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
