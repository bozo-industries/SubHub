<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF181220"
                android:centerColor="#FF21142E" android:endColor="#FF30133B" />
            <stroke android:width="1dp" android:color="#805A3470" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:height="2dp" android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/accent"
                android:endColor="@color/accent_hot" />
            <corners android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp" />
        </shape>
    </item>
</layer-list>
