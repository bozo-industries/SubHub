<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#D91A1123"
                android:centerColor="#E1261430" android:endColor="#D9190E20" />
            <stroke android:width="1dp" android:color="#765F2E72" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start"
        android:top="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="@color/accent_mid"
                android:endColor="@color/accent_hot" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
