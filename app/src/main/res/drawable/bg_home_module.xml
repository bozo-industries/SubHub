<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F0221828" />
            <stroke android:width="1dp" android:color="#8A73527B" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#E8131018"
                android:endColor="#E91A1420" />
            <stroke android:width="1dp" android:color="#51403649" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
