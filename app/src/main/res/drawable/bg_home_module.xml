<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#EF291832" />
            <stroke android:width="1dp" android:color="@color/accent_dim" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#C9120F19"
                android:endColor="#D91D1525" />
            <stroke android:width="1dp" android:color="#60392D43" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
