<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#332A0E35" />
            <stroke android:width="1dp" android:color="@color/accent_hot" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#EE130E1B"
                android:endColor="#EE1E1028" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
