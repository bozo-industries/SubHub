<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_disabled" />
            <stroke android:width="1dp" android:color="@color/outline_subtle" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#44142B"
                android:endColor="#221522" />
            <stroke android:width="2dp" android:color="@color/outline_selected" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_pressed" />
            <stroke android:width="1dp" android:color="@color/accent_hot" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card_raised" />
            <stroke android:width="2dp" android:color="@color/outline_focus" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#F20D0C12"
                android:endColor="#F218151E" />
            <stroke android:width="1dp" android:color="@color/outline_subtle" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
