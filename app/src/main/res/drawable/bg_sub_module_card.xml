<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_soft" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#F0120F1A"
                android:centerColor="#F0191422" android:endColor="#F022162B" />
            <stroke android:width="1dp" android:color="@color/outline_default" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
