<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_disabled" />
            <stroke android:width="1dp" android:color="@color/outline_subtle" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#63347A"
                android:endColor="#7C4891" />
            <stroke android:width="1dp" android:color="@color/outline_selected" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_pressed" />
            <stroke android:width="1dp" android:color="@color/accent_mid" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/surface_deep"
                android:endColor="@color/surface_card" />
            <stroke android:width="1dp" android:color="@color/outline_subtle" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
