<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#251F2A" />
            <stroke android:width="1dp" android:color="#463B4D" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4B294F"
                android:endColor="#321D38" />
            <stroke android:width="1dp" android:color="#B46D7AB5" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4D2A51"
                android:endColor="#35203B" />
            <stroke android:width="2dp" android:color="#C98C63CD" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#452449"
                android:centerColor="#3B213F" android:endColor="#2D1A34" />
            <stroke android:width="1dp" android:color="#8F704C84" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
