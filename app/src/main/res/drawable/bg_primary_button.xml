<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#493A4E" />
            <stroke android:width="1dp" android:color="@color/outline_subtle" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_dark" />
            <stroke android:width="1dp" android:color="@color/accent_hot" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/accent_mid"
                android:endColor="@color/accent_hot" />
            <stroke android:width="2dp" android:color="@color/outline_focus" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/accent"
                android:centerColor="@color/accent_mid" android:endColor="@color/accent_hot" />
            <stroke android:width="1dp" android:color="@color/accent_glow" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
