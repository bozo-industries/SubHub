<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FF401331"
                android:centerColor="#FF2C183B" android:endColor="#FF1B1326" />
            <stroke android:width="1dp" android:color="#604B285B" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/accent"
                android:endColor="@color/accent_hot" />
            <corners android:topLeftRadius="15dp" android:topRightRadius="15dp" />
        </shape>
    </item>
</layer-list>
