<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_soft" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#E82A172D"
                android:centerColor="#EC211824" android:endColor="#E614131C" />
            <stroke android:width="1dp" android:color="@color/outline_subtle" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top"
        android:left="13dp" android:right="13dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00F8EFFF"
                android:centerColor="@color/glass_highlight" android:endColor="#00F8EFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/accent_dim"
                android:endColor="@color/accent_hot_dim" />
            <corners android:topLeftRadius="15dp" android:topRightRadius="15dp" />
        </shape>
    </item>
</layer-list>
