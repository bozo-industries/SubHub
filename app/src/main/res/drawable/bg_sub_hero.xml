<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F31B1022"
                android:centerColor="#F6261330" android:endColor="#F3160D1C" />
            <stroke android:width="1dp" android:color="#805E2876" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:width="4dp" android:gravity="start"
        android:top="10dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="@color/accent"
                android:endColor="@color/accent_hot" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
