<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_soft" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/surface_deep"
                android:centerColor="@color/surface_card" android:endColor="@color/surface_card_raised" />
            <stroke android:width="1dp" android:color="@color/outline_subtle" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
