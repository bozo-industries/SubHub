<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF422054"
                android:endColor="#FF5A204B" />
            <stroke android:width="1dp" android:color="@color/accent_hot" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#F21D1428"
                android:endColor="#F229162F" />
            <stroke android:width="1dp" android:color="#806C3A79" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
