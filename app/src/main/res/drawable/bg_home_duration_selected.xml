<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A243F" />
            <stroke android:width="1dp" android:color="#B9855B91" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#322037"
                android:endColor="#25182B" />
            <stroke android:width="1dp" android:color="#9B754F86" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
