        <item name="android:layout_height">54dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/bg_tool_tile</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:drawableTint">@color/accent</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAlignment">gravity</item>
