<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="32dp"
            android:background="@drawable/bg_header_card" android:orientation="vertical" android:padding="16dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="40dp">
                <TextView android:id="@+id/button_back" android:layout_width="wrap_content"
                    android:layout_height="match_parent" android:gravity="center_vertical"
                    android:text="@string/back" android:textColor="@color/accent"
                    android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/button_edit_lock"
                    style="@style/Widget.SubHub.ControllerEdit"
                    android:layout_gravity="end|center_vertical"
                    android:text="@string/controller_edit_locked" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.1" android:text="@string/commitment_title"
                android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/commitment_subtitle"
                android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/setup_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                style="@style/Widget.SubHub.SectionHeader"
                android:text="@string/commitment_make_pact" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/commitment_setup_body"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <RadioGroup
                android:id="@+id/duration_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <RadioButton android:id="@+id/duration_1h" android:layout_width="match_parent" android:layout_height="48dp" android:checked="true" android:text="@string/commitment_duration_1h" android:textColor="@color/text_primary" />
                <RadioButton android:id="@+id/duration_24h" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/commitment_duration_24h" android:textColor="@color/text_primary" />
                <RadioButton android:id="@+id/duration_7d" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/commitment_duration_7d" android:textColor="@color/text_primary" />
                <RadioButton android:id="@+id/duration_30d" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/commitment_duration_30d" android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView style="@style/Widget.SubHub.FieldLabel"
                android:text="@string/commitment_code_label" />
            <TextView style="@style/Widget.SubHub.FieldHelp"
                android:text="@string/commitment_code_help" />
            <EditText
                android:id="@+id/keeper_code"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_card"
                android:hint="@string/commitment_code_hint"
                android:inputType="textPassword"
                android:maxLength="64"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />

            <TextView style="@style/Widget.SubHub.FieldLabel"
                android:text="@string/commitment_code_confirm_label" />
            <EditText
                android:id="@+id/keeper_code_confirm"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_card"
                android:hint="@string/commitment_code_confirm_hint"
                android:inputType="textPassword"
                android:maxLength="64"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />

            <Button
                android:id="@+id/button_seal_pact"
                style="@style/Widget.SubHub.PrimaryButton"
                android:layout_marginTop="14dp"
                android:text="@string/commitment_seal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/active_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView style="@style/Widget.SubHub.SectionHeader" android:text="@string/commitment_pact_sealed" />

            <TextView
                android:id="@+id/countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/commitment_active_body"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView style="@style/Widget.SubHub.FieldLabel"
                android:visibility="gone"
                android:text="@string/commitment_release_code_label" />
            <TextView style="@style/Widget.SubHub.FieldHelp"
                android:visibility="gone"
                android:text="@string/commitment_release_code_help" />
            <EditText
                android:id="@+id/release_code"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_card"
                android:hint="@string/commitment_release_code_hint"
                android:inputType="textPassword"
                android:maxLength="64"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:visibility="gone" />

            <Button
                android:id="@+id/button_keeper_release"
                style="@style/Widget.SubHub.CompactOutlineButton"
                android:layout_marginTop="8dp"
                android:text="@string/commitment_keeper_release"
                android:visibility="gone" />

            <TextView
                android:id="@+id/button_emergency_release"
                style="@style/Widget.SubHub.DangerAction"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/commitment_emergency_release"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/commitment_safety_note"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
