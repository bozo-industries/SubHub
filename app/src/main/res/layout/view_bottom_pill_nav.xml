<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_navigation"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_nav_height"
    android:layout_marginHorizontal="@dimen/bottom_nav_margin"
    android:layout_marginBottom="@dimen/bottom_nav_bottom_margin"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_bottom_pill"
    android:elevation="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="6dp">

    <TextView android:id="@+id/nav_censor" style="@style/Widget.SubHub.BottomTab"
        android:drawableTop="@drawable/ic_nav_censor" android:text="@string/nav_censor" />
    <TextView android:id="@+id/nav_limits" style="@style/Widget.SubHub.BottomTab"
        android:drawableTop="@drawable/ic_nav_limits" android:text="@string/nav_limits" />
    <TextView android:id="@+id/nav_money" style="@style/Widget.SubHub.BottomTab"
        android:drawableTop="@drawable/ic_nav_money" android:text="@string/nav_money" />
</LinearLayout>
