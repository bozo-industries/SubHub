<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/censor_page"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_main">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:id="@+id/page_content"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/page_margin" android:paddingTop="10dp"
        android:paddingEnd="@dimen/page_margin" android:paddingBottom="116dp">

        <include layout="@layout/view_main_header_nav" />

        <Button android:id="@+id/button_protection"
            style="@style/Widget.SubHub.PrimaryButton"
            android:layout_height="50dp" android:letterSpacing="0.1"
            android:text="@string/start_protection" android:textSize="14sp" />

        <LinearLayout android:id="@+id/protection_status_row"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="7dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <View android:id="@+id/protection_status_dot" android:layout_width="8dp"
                android:layout_height="8dp" android:layout_marginEnd="8dp"
                android:background="@drawable/bg_status_dot" />
            <TextView android:id="@+id/protection_status" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:letterSpacing="0.1"
                android:text="@string/status_inactive" android:textColor="@color/text_muted"
                android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/runtime_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center"
            android:text="@string/runtime_idle" android:textColor="@color/text_muted" android:textSize="10sp" />
        <TextView android:id="@+id/mode_hint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" android:gravity="center"
            android:text="@string/home_capture_desc" android:textColor="@color/text_muted" android:textSize="10sp" />

        <LinearLayout android:id="@+id/sub_dashboard"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">

            <LinearLayout android:id="@+id/sub_censor_card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_sub_hero" android:orientation="vertical"
                android:paddingStart="18dp" android:paddingTop="16dp"
                android:paddingEnd="16dp" android:paddingBottom="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:letterSpacing="0.15" android:text="@string/sub_censor_title"
                    android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/sub_censor_voice"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:lineSpacingExtra="2dp"
                    android:text="@string/sub_censor_idle" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/sub_censor_summary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <TextView android:id="@+id/sub_censor_stats"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/sub_limits_card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_sub_module_card"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:letterSpacing="0.14" android:text="@string/sub_limits_title"
                    android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/sub_limits_summary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="7dp" android:textColor="@color/text_primary"
                    android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/sub_limits_detail"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/sub_wallet_card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_sub_module_card"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:letterSpacing="0.14" android:text="@string/sub_wallet_title"
                    android:textColor="@color/accent_hot" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/sub_wallet_voice"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="7dp" android:textColor="@color/text_primary"
                    android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/sub_wallet_summary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <TextView android:id="@+id/sub_wallet_pay"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:layout_marginTop="10dp" android:background="@drawable/bg_outline_button"
                    android:clickable="true" android:focusable="true" android:gravity="center"
                    android:includeFontPadding="false" android:text="@string/sub_wallet_pay"
                    android:textColor="@color/accent_hot" android:textSize="11sp"
                    android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>

            <LinearLayout android:id="@+id/sub_modules_empty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_sub_module_card" android:orientation="vertical"
                android:padding="18dp" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/sub_dashboard_empty_title" android:textColor="@color/accent"
                    android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/sub_dashboard_empty_body"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/commitment_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="12dp" android:visibility="gone">
            <LinearLayout android:id="@+id/commitment_start_panel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/Widget.BetaSafe.SectionHeader"
                    android:text="@string/commitment_timer_title" />
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:layout_marginTop="3dp" android:text="@string/commitment_timer_help" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView android:id="@+id/commitment_timer_1h"
                        style="@style/Widget.BetaSafe.CompactAction"
                        android:text="@string/commitment_timer_1h" />
                    <TextView android:id="@+id/commitment_timer_24h"
                        style="@style/Widget.BetaSafe.CompactAction"
                        android:layout_marginStart="8dp" android:text="@string/commitment_timer_24h" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView android:id="@+id/commitment_timer_7d"
                        style="@style/Widget.BetaSafe.CompactAction"
                        android:text="@string/commitment_timer_7d" />
                    <TextView android:id="@+id/commitment_timer_30d"
                        style="@style/Widget.BetaSafe.CompactAction"
                        android:layout_marginStart="8dp" android:text="@string/commitment_timer_30d" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/commitment_active_panel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/commitment_pact_sealed" android:textColor="@color/accent"
                    android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/commitment_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
                <TextView android:id="@+id/button_commitment_view" android:layout_width="match_parent"
                    android:layout_height="42dp" android:layout_marginTop="9dp"
                    android:background="@drawable/bg_outline_button" android:clickable="true"
                    android:focusable="true" android:gravity="center" android:includeFontPadding="false"
                    android:text="@string/commitment_view_pact" android:textColor="@color/accent"
                    android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/dom_content"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="11dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.15" android:text="@string/home_capture_mode"
                android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:lineSpacingExtra="1dp"
                android:text="@string/home_capture_detail" android:textColor="@color/text_secondary" android:textSize="10sp" />
            <TextView android:id="@+id/button_accessibility_capture"
                android:layout_width="match_parent" android:layout_height="38dp"
                android:layout_marginTop="7dp" android:background="@drawable/bg_outline_button"
                android:clickable="true" android:focusable="true" android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/accessibility_capture_button" android:textColor="@color/accent"
                android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="8dp">
            <TextView style="@style/Widget.BetaSafe.SectionHeader"
                android:layout_marginHorizontal="3dp" android:layout_marginBottom="2dp"
                android:text="@string/censor_tools_title" />
            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:columnCount="@integer/censor_tool_columns" android:orientation="horizontal">
                <TextView android:id="@+id/button_censor_settings" style="@style/Widget.SubHub.ToolAction"
                    android:drawableTop="@drawable/ic_tab_settings" android:text="@string/censor_tool_settings" />
                <TextView android:id="@+id/button_browser" style="@style/Widget.SubHub.ToolAction"
                    android:drawableTop="@drawable/ic_tab_browser" android:text="@string/censor_tool_browser" />
                <TextView android:id="@+id/button_export" style="@style/Widget.SubHub.ToolAction"
                    android:drawableTop="@drawable/ic_tab_export" android:text="@string/censor_tool_export" />
                <TextView android:id="@+id/button_help" style="@style/Widget.SubHub.ToolAction"
                    android:drawableTop="@drawable/ic_tab_help" android:text="@string/censor_tool_help" />
            </GridLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:orientation="horizontal">
            <LinearLayout style="@style/Widget.BetaSafe.HomeStatCard" android:layout_marginEnd="4dp">
                <TextView android:id="@+id/stats_blocks" style="@style/Widget.BetaSafe.HomeStatValue" />
                <TextView style="@style/Widget.BetaSafe.HomeStatLabel" android:text="@string/stats_blocks" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.BetaSafe.HomeStatCard" android:layout_marginHorizontal="4dp">
                <TextView android:id="@+id/stats_time" style="@style/Widget.BetaSafe.HomeStatValue" />
                <TextView style="@style/Widget.BetaSafe.HomeStatLabel" android:text="@string/stat_session" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.BetaSafe.HomeStatCard" android:layout_marginStart="4dp">
                <TextView android:id="@+id/stats_sessions" style="@style/Widget.BetaSafe.HomeStatValue" />
                <TextView style="@style/Widget.BetaSafe.HomeStatLabel" android:text="@string/stats_sessions" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/button_statistics" android:layout_width="match_parent"
            android:layout_height="42dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card"
            android:clickable="true" android:focusable="true" android:gravity="center_vertical"
            android:paddingHorizontal="16dp" android:text="@string/statistics_view"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />

        <LinearLayout android:id="@+id/onboarding_card" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="14dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/onboarding_title" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:text="@string/onboarding_body"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="horizontal">
                <TextView android:id="@+id/onboarding_help" style="@style/Widget.BetaSafe.CompactAction"
                    android:text="@string/onboarding_help" />
                <TextView android:id="@+id/onboarding_dismiss" style="@style/Widget.BetaSafe.CompactAction"
                    android:layout_marginStart="8dp" android:text="@string/onboarding_dismiss" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/penance_card" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card"
            android:gravity="center_vertical" android:orientation="horizontal" android:padding="11dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/penance_home_title" android:textColor="@color/accent"
                    android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/penance_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="3dp"
                    android:textColor="@color/text_secondary" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:id="@+id/button_penance_view" android:layout_width="108dp"
                android:layout_height="38dp" android:layout_marginStart="8dp"
                android:background="@drawable/bg_outline_button" android:clickable="true"
                android:focusable="true" android:gravity="center" android:text="@string/penance_open"
                android:textColor="@color/accent" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
<include layout="@layout/view_bottom_pill_nav" />
</FrameLayout>
