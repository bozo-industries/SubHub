<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_achievement_home"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.subhub.app.stats.AchievementBadgeView
        android:id="@+id/achievement_unlock_badge"
        android:layout_width="76dp"
        android:layout_height="76dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:letterSpacing="0.14"
        android:text="@string/achievement_unlocked_title"
        android:textColor="@color/accent_hot"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/achievement_unlock_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/achievement_unlock_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/achievement_unlock_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:textColor="@color/accent_mid"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/achievement_unlock_action"
        style="@style/Widget.SubHub.PrimaryButton"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:text="@string/achievements_view_all" />
</LinearLayout>
