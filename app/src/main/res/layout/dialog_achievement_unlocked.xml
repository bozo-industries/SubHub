<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_achievement_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp" android:paddingTop="24dp"
    android:paddingEnd="24dp" android:paddingBottom="22dp">

    <com.subhub.app.stats.AchievementBadgeView
        android:id="@+id/achievement_unlock_badge"
        android:layout_width="116dp"
        android:layout_height="116dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:letterSpacing="0.14"
        android:text="@string/achievement_unlocked_title"
        android:textColor="@color/accent_hot"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/achievement_unlock_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/achievement_unlock_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/achievement_unlock_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:textColor="@color/accent_mid"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/achievement_unlock_action"
        style="@style/Widget.SubHub.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:maxLines="1" android:textSize="12sp"
        android:text="@string/achievements_view_all" />
</LinearLayout>
