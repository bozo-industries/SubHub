<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="1dp"
    android:paddingTop="2dp"
    android:paddingEnd="1dp"
    android:paddingBottom="2dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_home_metric"
        android:contentDescription="@string/nav_home"
        android:padding="3dp"
        android:src="@drawable/ic_launcher_foreground" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:letterSpacing="0.1" android:text="@string/app_name"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary" android:textSize="19sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/header_subtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:text="@string/header_subtitle"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/text_secondary" android:textSize="10sp" />
    </LinearLayout>

    <TextView android:id="@+id/button_edit_lock"
        style="@style/Widget.SubHub.ControllerEdit"
        android:text="@string/controller_edit_locked" />
</LinearLayout>
