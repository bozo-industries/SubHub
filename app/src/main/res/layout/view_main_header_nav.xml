<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="15dp"
        android:paddingEnd="20dp"
        android:paddingBottom="15dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/header_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.08"
            android:text="@string/header_subtitle"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@color/accent_dim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView android:id="@+id/tab_home" style="@style/Widget.BetaSafe.Tab"
            android:drawableTop="@drawable/ic_tab_home" android:text="@string/tab_home" />
        <TextView android:id="@+id/tab_settings" style="@style/Widget.BetaSafe.Tab"
            android:drawableTop="@drawable/ic_tab_settings" android:text="@string/tab_settings" />
        <TextView android:id="@+id/tab_browser" style="@style/Widget.BetaSafe.Tab"
            android:drawableTop="@drawable/ic_tab_browser" android:text="@string/tab_browser" />
        <TextView android:id="@+id/tab_help" style="@style/Widget.BetaSafe.Tab"
            android:drawableTop="@drawable/ic_tab_help" android:text="@string/tab_help" />
        <TextView android:id="@+id/tab_export" style="@style/Widget.BetaSafe.Tab"
            android:drawableTop="@drawable/ic_tab_export" android:text="@string/tab_export" />
    </LinearLayout>
</LinearLayout>
