<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="36dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" android:background="@drawable/bg_header_card"
            android:orientation="vertical" android:padding="16dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="40dp">
                <TextView android:id="@+id/button_back" android:layout_width="wrap_content"
                    android:layout_height="match_parent" android:gravity="center_vertical"
                    android:text="@string/back" android:textColor="@color/accent"
                    android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/button_edit_lock"
                    style="@style/Widget.SubHub.ControllerEdit"
                    android:layout_gravity="end|center_vertical"
                    android:text="@string/controller_edit_locked" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.1" android:text="@string/settings_title"
                android:textColor="@color/text_primary" android:textSize="18sp"
                android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/settings_subtitle"
                android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/settings_quick_tools" android:textColor="@color/text_primary"
                android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/settings_quick_tools_desc"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/appearance_title"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/style_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="@integer/settings_grid_columns">

                <RadioButton
                    android:id="@+id/radio_box"
                    style="@style/Widget.BetaSafe.OptionRadio"
                    android:text="@string/style_box" />

                <RadioButton
                    android:id="@+id/radio_pixelate"
                    style="@style/Widget.BetaSafe.OptionRadio"
                    android:text="@string/style_pixelate" />

                <RadioButton
                    android:id="@+id/radio_blur"
                    style="@style/Widget.BetaSafe.OptionRadio"
                    android:text="@string/style_blur" />

                <RadioButton
                    android:id="@+id/radio_bar"
                    style="@style/Widget.BetaSafe.OptionRadio"
                    android:text="@string/style_bar" />

                <RadioButton
                    android:id="@+id/radio_custom"
                    style="@style/Widget.BetaSafe.OptionRadio"
                    android:text="@string/style_custom" />

                <RadioButton
                    android:id="@+id/radio_static"
                    style="@style/Widget.BetaSafe.OptionRadio"
                    android:text="@string/style_static" />

                <RadioButton
                    android:id="@+id/radio_glitch"
                    style="@style/Widget.BetaSafe.OptionRadio"
                    android:text="@string/style_glitch" />

                <RadioButton
                    android:id="@+id/radio_tape"
                    style="@style/Widget.BetaSafe.OptionRadio"
                    android:text="@string/style_tape" />

                <RadioButton
                    android:id="@+id/radio_error"
                    style="@style/Widget.BetaSafe.OptionRadio"
                    android:text="@string/style_error" />
            </GridLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/intensity"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/intensity_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/intensity_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/censor_padding"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/padding_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/padding_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_border"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/show_border"
                android:textColor="@color/text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_text"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/show_text"
                android:textColor="@color/text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_animate_border"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/animate_border"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/border_effect"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/border_effect_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/radio_border_classic"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/border_classic"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_border_glow"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/border_glow"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_border_gradient"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/border_gradient"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_border_rainbow"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/border_rainbow"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_reverse"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/reverse_mode"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reverse_strength"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reverse_strength_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/reverse_strength_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:min="1"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <Button
                android:id="@+id/button_custom_images"
                style="@style/Widget.SubHub.PrimaryButton"
                android:layout_marginTop="12dp"
                android:text="@string/manage_custom_images" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/detection_title"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/confidence"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/confidence_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/performance_preset"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/preset_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/radio_preset_low"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/preset_low"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_preset_medium"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/preset_medium"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_preset_high"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/preset_high"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_preset_ultra"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/preset_ultra"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <SeekBar
                android:id="@+id/confidence_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="80"
                android:min="10"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/categories_title"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:columnCount="2">
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_genitals_female" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/category_genitals_female" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_genitals_male" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/category_genitals_male" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_breasts" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/category_breasts" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_buttocks" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/category_buttocks" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_anus" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/category_anus" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_faces" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/category_faces" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_male_chest" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/category_male_chest" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_belly" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/category_belly" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_feet" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/category_feet" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_armpits" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/category_armpits" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_covered" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/category_covered" />
            </GridLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/phrases_title"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:columnCount="2">
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_phrase_short" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/phrase_short" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_phrase_denial" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/phrase_denial" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_phrase_humiliation" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/phrase_humiliation" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_phrase_edge" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/phrase_edge" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_phrase_findom" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/phrase_findom" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_phrase_ntr" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/phrase_ntr" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_phrase_gooner" style="@style/Widget.SubHub.SettingsToggle"
                    android:text="@string/phrase_gooner" />
            </GridLayout>

            <TextView style="@style/Widget.SubHub.FieldLabel"
                android:text="@string/custom_phrases_label" />
            <TextView style="@style/Widget.SubHub.FieldHelp"
                android:text="@string/custom_phrases_help" />
            <EditText
                android:id="@+id/custom_phrases"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_card"
                android:gravity="top|start"
                android:hint="@string/custom_phrases_hint"
                android:inputType="textMultiLine"
                android:maxLength="1000"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />

            <Button
                android:id="@+id/button_save_phrases"
                style="@style/Widget.SubHub.PrimaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/save_phrases" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/configuration_title"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:columnCount="2">
                <TextView android:id="@+id/button_profiles" style="@style/Widget.SubHub.SettingsAction"
                    android:text="@string/manage_profiles" />
                <TextView android:id="@+id/button_packs" style="@style/Widget.SubHub.SettingsAction"
                    android:text="@string/manage_packs" />
                <TextView android:id="@+id/button_popup_storm" style="@style/Widget.SubHub.SettingsAction"
                    android:text="@string/manage_popup_storm" />
                <TextView android:id="@+id/button_diagnostics" style="@style/Widget.SubHub.SettingsAction"
                    android:text="@string/manage_diagnostics" />
                <TextView android:id="@+id/button_commitment" style="@style/Widget.SubHub.SettingsAction"
                    android:text="@string/manage_commitment" />
                <TextView android:id="@+id/button_app_mode" style="@style/Widget.SubHub.SettingsAction"
                    android:text="@string/manage_app_mode" />
            </GridLayout>

            <TextView
                android:id="@+id/pack_lock_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/settings_saved"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
