<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/button_back"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/back"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.12"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/appearance_title"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/style_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_box"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/style_box"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_pixelate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/style_pixelate"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_blur"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/style_blur"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_bar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/style_bar"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/intensity"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/intensity_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/intensity_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_border"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/show_border"
                android:textColor="@color/text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_text"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/show_text"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/detection_title"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/confidence"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/confidence_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/confidence_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="80"
                android:min="10"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/categories_title"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_genitals_female"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/category_genitals_female"
                android:textColor="@color/text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_genitals_male"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/category_genitals_male"
                android:textColor="@color/text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_breasts"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/category_breasts"
                android:textColor="@color/text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_buttocks"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/category_buttocks"
                android:textColor="@color/text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_anus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/category_anus"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/settings_saved"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
