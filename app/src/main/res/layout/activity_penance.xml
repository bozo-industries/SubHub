<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/money_page" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/bg_main">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="116dp">
            <LinearLayout android:id="@+id/penance_header"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="10dp"
                android:background="@drawable/bg_header_card" android:gravity="center_vertical"
                android:orientation="horizontal" android:padding="14dp">
                <TextView android:id="@+id/button_back" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:gravity="center_vertical"
                    android:text="@string/back" android:textColor="@color/accent"
                    android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
                <ImageView android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_bottom_tab_active"
                    android:contentDescription="@string/penance_title" android:padding="10dp"
                    android:src="@drawable/ic_nav_money" app:tint="@color/text_primary" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="11dp" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:letterSpacing="0.1" android:text="@string/penance_title"
                        android:textColor="@color/text_primary" android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/penance_subtitle"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="@string/penance_subtitle"
                        android:textColor="@color/text_secondary" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:id="@+id/button_edit_lock"
                    style="@style/Widget.SubHub.ControllerEdit"
                    android:text="@string/controller_edit_locked" />
            </LinearLayout>

            <LinearLayout android:id="@+id/balance_card"
                style="@style/Widget.SubHub.CompactCard">
                <TextView style="@style/Widget.BetaSafe.SectionHeader"
                    android:text="@string/penance_balance_label" />
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:columnCount="2" android:layout_marginTop="6dp">
                    <LinearLayout style="@style/Widget.SubHub.BalanceTile">
                        <TextView android:id="@+id/due_amount" style="@style/Widget.SubHub.BalanceValue" />
                        <TextView style="@style/Widget.SubHub.BalanceLabel" android:text="@string/penance_due_label" />
                    </LinearLayout>
                    <LinearLayout style="@style/Widget.SubHub.BalanceTile">
                        <TextView android:id="@+id/mercy_amount" style="@style/Widget.SubHub.BalanceValue" />
                        <TextView style="@style/Widget.SubHub.BalanceLabel" android:text="@string/penance_mercy_label" />
                    </LinearLayout>
                    <LinearLayout style="@style/Widget.SubHub.BalanceTile">
                        <TextView android:id="@+id/checkout_amount" style="@style/Widget.SubHub.BalanceValue" />
                        <TextView style="@style/Widget.SubHub.BalanceLabel" android:text="@string/penance_checkout_label" />
                    </LinearLayout>
                    <LinearLayout style="@style/Widget.SubHub.BalanceTile">
                        <TextView android:id="@+id/paid_amount" style="@style/Widget.SubHub.BalanceValue" />
                        <TextView style="@style/Widget.SubHub.BalanceLabel" android:text="@string/penance_paid_label" />
                    </LinearLayout>
                </GridLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/rule_config_card"
                style="@style/Widget.SubHub.CompactCard">
                <TextView style="@style/Widget.BetaSafe.SectionHeader" android:text="@string/penance_rules_title" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="@string/penance_rules_body"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
                <TextView android:id="@+id/rule_math_preview"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:background="@drawable/bg_stat_card"
                    android:lineSpacingExtra="2dp" android:padding="10dp"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
                <CheckBox android:id="@+id/ledger_enabled" android:layout_width="match_parent"
                    android:layout_height="42dp" android:layout_marginTop="4dp"
                    android:buttonTint="@color/accent" android:text="@string/penance_enabled"
                    android:textColor="@color/text_primary" />
                <GridLayout android:id="@+id/rule_grid" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:columnCount="2">
                    <LinearLayout style="@style/Widget.SubHub.RuleTile">
                        <CheckBox android:id="@+id/rule_detection_enabled" style="@style/Widget.SubHub.RuleToggle"
                            android:text="@string/penance_rule_detection_title" />
                        <TextView style="@style/Widget.SubHub.RuleHelp"
                            android:text="@string/penance_rule_detection_help" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView style="@style/Widget.SubHub.RuleCostLabel" />
                                <EditText android:id="@+id/rule_detection_amount"
                                    style="@style/Widget.SubHub.MoneyInput" />
                            </LinearLayout>
                            <Space android:layout_width="5dp" android:layout_height="1dp" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView style="@style/Widget.SubHub.RuleCostLabel"
                                    android:text="@string/penance_detection_batch_label" />
                                <EditText android:id="@+id/detection_batch"
                                    style="@style/Widget.SubHub.IntegerInput" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout style="@style/Widget.SubHub.RuleTile">
                        <CheckBox android:id="@+id/rule_dwell_enabled" style="@style/Widget.SubHub.RuleToggle"
                            android:text="@string/penance_rule_dwell_title" />
                        <TextView style="@style/Widget.SubHub.RuleHelp" android:text="@string/penance_rule_dwell_help" />
                        <TextView style="@style/Widget.SubHub.RuleCostLabel" />
                        <EditText android:id="@+id/rule_dwell_amount" style="@style/Widget.SubHub.MoneyInput" />
                    </LinearLayout>
                    <LinearLayout style="@style/Widget.SubHub.RuleTile">
                        <CheckBox android:id="@+id/rule_tap_enabled" style="@style/Widget.SubHub.RuleToggle"
                            android:text="@string/penance_rule_tap_title" />
                        <TextView style="@style/Widget.SubHub.RuleHelp" android:text="@string/penance_rule_tap_help" />
                        <TextView style="@style/Widget.SubHub.RuleCostLabel" />
                        <EditText android:id="@+id/rule_tap_amount" style="@style/Widget.SubHub.MoneyInput" />
                    </LinearLayout>
                    <LinearLayout style="@style/Widget.SubHub.RuleTile">
                        <CheckBox android:id="@+id/rule_app_open_enabled" style="@style/Widget.SubHub.RuleToggle"
                            android:text="@string/penance_rule_app_open_title" />
                        <TextView style="@style/Widget.SubHub.RuleHelp" android:text="@string/penance_rule_app_open_help" />
                        <TextView style="@style/Widget.SubHub.RuleCostLabel" />
                        <EditText android:id="@+id/rule_app_open_amount" style="@style/Widget.SubHub.MoneyInput" />
                    </LinearLayout>
                </GridLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/safety_config_card"
                style="@style/Widget.SubHub.CompactCard">
                <TextView style="@style/Widget.BetaSafe.SectionHeader" android:text="@string/penance_safety_limits_title" />
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:columnCount="2" android:layout_marginTop="2dp">
                    <LinearLayout style="@style/Widget.SubHub.FieldTile">
                        <TextView style="@style/Widget.SubHub.FieldLabel" android:text="@string/penance_daily_label" />
                        <TextView style="@style/Widget.SubHub.FieldHelp" android:text="@string/penance_daily_help" />
                        <EditText android:id="@+id/daily_cap" style="@style/Widget.SubHub.MoneyInput" />
                    </LinearLayout>
                    <LinearLayout style="@style/Widget.SubHub.FieldTile">
                        <TextView style="@style/Widget.SubHub.FieldLabel" android:text="@string/penance_weekly_label" />
                        <TextView style="@style/Widget.SubHub.FieldHelp" android:text="@string/penance_weekly_help" />
                        <EditText android:id="@+id/weekly_cap" style="@style/Widget.SubHub.MoneyInput" />
                    </LinearLayout>
                    <LinearLayout style="@style/Widget.SubHub.FieldTile">
                        <TextView style="@style/Widget.SubHub.FieldLabel" android:text="@string/penance_mercy_label_input" />
                        <TextView style="@style/Widget.SubHub.FieldHelp" android:text="@string/penance_mercy_help" />
                        <EditText android:id="@+id/mercy_minutes" style="@style/Widget.SubHub.IntegerInput" />
                    </LinearLayout>
                    <LinearLayout style="@style/Widget.SubHub.FieldTile">
                        <TextView style="@style/Widget.SubHub.FieldLabel" android:text="@string/penance_dwell_seconds_label" />
                        <TextView style="@style/Widget.SubHub.FieldHelp" android:text="@string/penance_dwell_seconds_help" />
                        <EditText android:id="@+id/dwell_seconds" style="@style/Widget.SubHub.IntegerInput" />
                    </LinearLayout>
                </GridLayout>
                <CheckBox android:id="@+id/payment_consent" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:buttonTint="@color/accent" android:text="@string/penance_consent"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
                <Button android:id="@+id/button_save_rules" style="@style/Widget.SubHub.PrimaryButton"
                    android:layout_marginTop="7dp" android:text="@string/penance_save_rules" />
            </LinearLayout>

            <LinearLayout android:id="@+id/checkout_card"
                style="@style/Widget.SubHub.CompactCard">
                <TextView style="@style/Widget.BetaSafe.SectionHeader" android:text="@string/penance_checkout_title" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="@string/penance_checkout_body"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
                <TextView android:id="@+id/payment_availability" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="7dp"
                    android:textColor="@color/text_muted" android:textSize="10sp" />
                <TextView android:id="@+id/payment_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center"
                    android:textColor="@color/accent" android:textStyle="bold" />
                <Button android:id="@+id/button_settle" style="@style/Widget.SubHub.PrimaryButton"
                    android:layout_marginTop="7dp" android:text="@string/penance_settle" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:orientation="horizontal">
                    <TextView android:id="@+id/button_resume_checkout" style="@style/Widget.BetaSafe.CompactAction"
                        android:text="@string/penance_resume" android:visibility="gone" />
                    <TextView android:id="@+id/button_cancel_checkout" style="@style/Widget.BetaSafe.CompactAction"
                        android:text="@string/penance_cancel_checkout" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/corrections_card"
                style="@style/Widget.SubHub.CompactCard">
                <TextView style="@style/Widget.BetaSafe.SectionHeader" android:text="@string/penance_mercy_title" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:orientation="horizontal">
                    <TextView android:id="@+id/button_forgive_latest" style="@style/Widget.BetaSafe.CompactAction"
                        android:text="@string/penance_forgive_latest" />
                    <TextView android:id="@+id/button_clear_unpaid" style="@style/Widget.BetaSafe.CompactAction"
                        android:clickable="true" android:focusable="true" android:gravity="center"
                        android:text="@string/penance_clear_unpaid" android:textColor="@color/accent" />
                </LinearLayout>
                <Button android:id="@+id/button_test_strike" style="@style/Widget.SubHub.PrimaryButton"
                    android:layout_height="40dp" android:layout_marginTop="6dp"
                    android:text="@string/penance_test_strike" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.SubHub.CompactCard">
                <TextView style="@style/Widget.BetaSafe.SectionHeader" android:text="@string/penance_history_title" />
                <TextView android:id="@+id/history" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="7dp"
                    android:lineSpacingExtra="3dp" android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_pill_nav" />
</FrameLayout>
