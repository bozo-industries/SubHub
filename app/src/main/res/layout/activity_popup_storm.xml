<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginTop="32dp"
            android:background="@drawable/bg_header_card" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/button_back" android:layout_width="wrap_content"
                android:layout_height="40dp" android:gravity="center_vertical" android:text="@string/back"
                android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/popup_header_title" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:letterSpacing="0.1"
                android:text="@string/popup_title" android:textColor="@color/text_primary"
                android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/popup_subtitle"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_enabled"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/popup_enable"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_preview"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_primary_button"
                    android:text="@string/popup_preview"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_stop"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/popup_stop_now" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView style="@style/Widget.BetaSafe.SectionHeader"
                android:text="@string/popup_presets" />
            <LinearLayout android:id="@+id/preset_container"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView style="@style/Widget.BetaSafe.SectionHeader"
                android:text="@string/popup_library" />
            <TextView android:id="@+id/library_count" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="7dp"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
            <Button android:id="@+id/button_add_folder" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="10dp"
                android:text="@string/popup_add_folder" />
            <LinearLayout android:id="@+id/folders_list" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dynamic_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
