<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/primary_header_top"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="24dp">

        <include layout="@layout/view_secondary_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView style="@style/Widget.SubHub.FieldHelp"
            android:layout_marginTop="8dp" android:text="@string/diagnostics_desc" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_runtime"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/runtime_status"
                style="@style/Widget.SubHub.DiagnosticsText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_performance"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/performance_status"
                style="@style/Widget.SubHub.DiagnosticsText" />

            <com.subhub.app.util.StateToggle
                android:id="@+id/switch_diagnostics_overlay"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="@string/diagnostics_overlay"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_overlay_desc"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_configuration"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/configuration_status"
                style="@style/Widget.SubHub.DiagnosticsText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_permissions"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permissions_status"
                style="@style/Widget.SubHub.DiagnosticsText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_build"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/build_status"
                style="@style/Widget.SubHub.DiagnosticsText" />
        </LinearLayout>

        <Button
            android:id="@+id/button_refresh"
            style="@style/Widget.SubHub.PrimaryButton"
            android:layout_marginTop="14dp"
            android:text="@string/diagnostics_refresh" />
    </LinearLayout>
</ScrollView>
