<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/diagnostics_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_header_card" android:orientation="vertical"
            android:padding="16dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="40dp">
                <TextView android:id="@+id/button_back" android:layout_width="wrap_content"
                    android:layout_height="match_parent" android:gravity="center_vertical"
                    android:text="@string/back" android:textColor="@color/accent"
                    android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/button_edit_lock"
                    style="@style/Widget.SubHub.ControllerEdit"
                    android:layout_gravity="end|center_vertical"
                    android:text="@string/controller_edit_locked" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.1" android:text="@string/diagnostics_title"
                android:textColor="@color/text_primary" android:textSize="18sp"
                android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/diagnostics_desc"
                android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/censor_lab_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_lab_title"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/diagnostics_lab_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/censor_lab_status"
                style="@style/Widget.SubHub.DiagnosticsText"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/censor_lab_sync_marker"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:background="@color/accent"
                android:gravity="center"
                android:textColor="@color/background"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_censor_lab_start"
                    style="@style/Widget.SubHub.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/diagnostics_lab_start" />

                <Button
                    android:id="@+id/button_censor_lab_stop"
                    style="@style/Widget.SubHub.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/diagnostics_lab_stop" />
            </LinearLayout>

            <Button
                android:id="@+id/button_censor_lab_attach"
                style="@style/Widget.SubHub.PrimaryButton"
                android:layout_marginTop="8dp"
                android:text="@string/diagnostics_lab_share_bundle" />

            <Button
                android:id="@+id/button_censor_lab_share_trace"
                style="@style/Widget.SubHub.PrimaryButton"
                android:layout_marginTop="8dp"
                android:text="@string/diagnostics_lab_share_trace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_runtime"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/runtime_status"
                style="@style/Widget.SubHub.DiagnosticsText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_performance"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/performance_status"
                style="@style/Widget.SubHub.DiagnosticsText" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_diagnostics_overlay"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="@string/diagnostics_overlay"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_overlay_desc"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_configuration"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/configuration_status"
                style="@style/Widget.SubHub.DiagnosticsText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_permissions"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permissions_status"
                style="@style/Widget.SubHub.DiagnosticsText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_build"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/build_status"
                style="@style/Widget.SubHub.DiagnosticsText" />
        </LinearLayout>

        <Button
            android:id="@+id/button_refresh"
            style="@style/Widget.SubHub.PrimaryButton"
            android:layout_marginTop="14dp"
            android:text="@string/diagnostics_refresh" />
    </LinearLayout>
</ScrollView>
