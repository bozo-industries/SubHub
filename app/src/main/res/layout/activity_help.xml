<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <FrameLayout android:layout_width="match_parent" android:layout_height="210dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:alpha="0.72" android:contentDescription="@null"
                android:scaleType="centerCrop" android:src="@drawable/betasafe_gothic_header" />
            <View android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="#550D0D14" />
            <TextView android:id="@+id/button_back" android:layout_width="wrap_content"
                android:layout_height="48dp" android:layout_gravity="top|start"
                android:layout_marginStart="20dp" android:layout_marginTop="8dp"
                android:gravity="center_vertical" android:text="@string/back"
                android:textColor="@color/accent" android:textStyle="bold" />
            <ImageView android:layout_width="145dp" android:layout_height="155dp"
                android:layout_gravity="bottom|start" android:contentDescription="@string/popup_guardian_desc"
                android:scaleType="centerInside" android:src="@drawable/betasafe_demoness_guardian" />
            <LinearLayout android:layout_width="220dp" android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end" android:layout_marginEnd="22dp"
                android:orientation="vertical">
                <TextView android:id="@+id/help_header_title"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:letterSpacing="0.1" android:text="@string/help_title"
                    android:textColor="@color/text_primary" android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="@string/help_subtitle"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginTop="16dp"
            android:background="@drawable/bg_card" android:orientation="vertical"
            android:padding="18dp">
            <TextView style="@style/Widget.BetaSafe.SectionHeader"
                android:text="@string/help_permission_check" />
            <TextView android:id="@+id/permission_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
            <Button android:id="@+id/button_fix_permissions" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="10dp"
                android:background="@drawable/bg_primary_button" android:text="@string/help_fix_permissions"
                android:textColor="@color/text_primary" android:textStyle="bold" />
            <Button android:id="@+id/button_accessibility" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="@string/help_accessibility_settings" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginTop="14dp"
            android:background="@drawable/bg_card" android:orientation="vertical"
            android:padding="18dp">
            <TextView style="@style/Widget.BetaSafe.SectionHeader"
                android:text="@string/settings_language" />
            <TextView android:id="@+id/language_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
            <Button android:id="@+id/button_language" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="10dp"
                android:text="@string/help_choose_language" />
        </LinearLayout>

        <LinearLayout android:id="@+id/help_sections" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
