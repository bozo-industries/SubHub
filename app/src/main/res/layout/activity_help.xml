<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="32dp"
            android:layout_marginBottom="14dp" android:background="@drawable/bg_header_card"
            android:orientation="vertical" android:padding="16dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="40dp">
                <TextView android:id="@+id/button_back" android:layout_width="wrap_content"
                    android:layout_height="match_parent" android:gravity="center_vertical"
                    android:text="@string/back" android:textColor="@color/accent"
                    android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/button_edit_lock"
                    style="@style/Widget.SubHub.ControllerEdit"
                    android:layout_gravity="end|center_vertical"
                    android:text="@string/controller_edit_locked" />
            </FrameLayout>
            <TextView android:id="@+id/help_header_title" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:letterSpacing="0.1"
                android:text="@string/help_title" android:textColor="@color/text_primary"
                android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/help_subtitle"
                android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:background="@drawable/bg_card" android:orientation="vertical"
            android:padding="14dp">
            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:text="@string/help_permission_check" />
            <TextView android:id="@+id/permission_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
            <Button android:id="@+id/button_fix_permissions" android:layout_width="match_parent"
                style="@style/Widget.SubHub.CompactOutlineButton"
                android:layout_marginTop="10dp" android:text="@string/help_fix_permissions" />
            <Button android:id="@+id/button_accessibility" android:layout_width="match_parent"
                style="@style/Widget.SubHub.CompactOutlineButton"
                android:layout_marginTop="6dp" android:text="@string/help_accessibility_settings" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="14dp"
            android:background="@drawable/bg_card" android:orientation="vertical"
            android:padding="14dp">
            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:text="@string/settings_language" />
            <TextView android:id="@+id/language_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
            <Button android:id="@+id/button_language" android:layout_width="match_parent"
                style="@style/Widget.SubHub.CompactOutlineButton"
                android:layout_marginTop="10dp" android:text="@string/help_choose_language" />
        </LinearLayout>

        <LinearLayout android:id="@+id/help_sections" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="14dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
