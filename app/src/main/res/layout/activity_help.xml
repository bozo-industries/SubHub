<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginTop="32dp"
            android:orientation="vertical">
            <TextView android:id="@+id/button_back" android:layout_width="1dp"
                android:layout_height="1dp" android:visibility="gone" />
            <TextView android:id="@+id/help_header_title" android:layout_width="1dp"
                android:layout_height="1dp" android:text="@string/help_title"
                android:visibility="gone" />
            <include layout="@layout/view_main_header_nav" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_card" android:orientation="vertical"
            android:padding="14dp">
            <TextView style="@style/Widget.BetaSafe.SectionHeader"
                android:text="@string/help_permission_check" />
            <TextView android:id="@+id/permission_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
            <Button android:id="@+id/button_fix_permissions" android:layout_width="match_parent"
                android:layout_height="44dp" android:layout_marginTop="10dp"
                android:background="@drawable/bg_outline_button" android:text="@string/help_fix_permissions"
                android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" />
            <Button android:id="@+id/button_accessibility" android:layout_width="match_parent"
                android:layout_height="44dp" android:layout_marginTop="6dp"
                android:background="@drawable/bg_outline_button" android:text="@string/help_accessibility_settings"
                android:textColor="@color/accent" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginTop="14dp"
            android:background="@drawable/bg_card" android:orientation="vertical"
            android:padding="14dp">
            <TextView style="@style/Widget.BetaSafe.SectionHeader"
                android:text="@string/settings_language" />
            <TextView android:id="@+id/language_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
            <Button android:id="@+id/button_language" android:layout_width="match_parent"
                android:layout_height="44dp" android:layout_marginTop="10dp"
                android:background="@drawable/bg_outline_button" android:text="@string/help_choose_language"
                android:textColor="@color/accent" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/help_sections" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
